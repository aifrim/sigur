{
  "name": "@sigur/node",
  "version": "0.1.0",
  "description": "Result-returning Node/JS globals for Sigur (JSON, fetch, URL, …)",
  "keywords": [
    "result",
    "error",
    "errors-as-values",
    "sigur",
    "node"
  ],
  "author": "Alexandru Ifrim <me@aifrim.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aifrim/sigur.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/aifrim/sigur/tree/main/packages/node",
  "bugs": {
    "url": "https://github.com/aifrim/sigur/issues"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sigur/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.*",
    "typescript": "7.*",
    "vitest": "3.*"
  },
  "engines": {
    "node": ">=24"
  }
}
