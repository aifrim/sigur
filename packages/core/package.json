{
  "name": "@sigur/core",
  "version": "0.1.0",
  "description": "Result / ResultAsync — errors as values for JavaScript and TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "Alexandru Ifrim <me@aifrim.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aifrim/sigur.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aifrim/sigur/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/aifrim/sigur/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "result",
    "error",
    "errors-as-values",
    "neverthrow",
    "typescript"
  ]
}
